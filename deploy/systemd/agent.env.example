AUTOFORGE_SERVER_URL=https://autoforge.internal
AUTOFORGE_AGENT_DATA_DIR=/var/lib/autoforge-agent
AUTOFORGE_AGENT_NAME=runner-01
AUTOFORGE_AGENT_LABELS=linux,java
AUTOFORGE_AGENT_MAX_CONCURRENCY=1
AUTOFORGE_AGENT_CGROUP_ROOT=auto
AUTOFORGE_AGENT_CLAIM_WAIT=20s
AUTOFORGE_AGENT_CLAIM_MAX_BACKOFF=30s
AUTOFORGE_AGENT_SHUTDOWN_GRACE=30s
AUTOFORGE_AGENT_SPOOL_MAX_BYTES=536870912
AUTOFORGE_AGENT_SPOOL_RETENTION=168h
AUTOFORGE_AGENT_LOG_UPLOAD_BATCH=128
AUTOFORGE_AGENT_CA_FILE=/etc/autoforge-agent/ca.pem
AUTOFORGE_AGENT_JAVA_EXECUTABLE=/opt/autoforge-toolchain/jdk/bin/java
AUTOFORGE_AGENT_TESTNG_CLASSPATH=/opt/autoforge-toolchain/testng/testng.jar:/opt/autoforge-toolchain/testng/jcommander.jar
AUTOFORGE_AGENT_JAVA_VERSION=21.0.8
AUTOFORGE_AGENT_TESTNG_VERSION=7.11.0
