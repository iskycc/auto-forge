AUTOFORGE_BACKEND_IMAGE=autoforge/backend:VERSION-amd64
AUTOFORGE_HTTP_BIND=0.0.0.0
AUTOFORGE_HTTP_PORT=3000
AUTOFORGE_DATA_VOLUME=autoforge-lite-data

# 以下示例值只能用于说明格式。部署前必须在离线环境生成并替换。
AUTOFORGE_RUNNER_BOOTSTRAP_TOKEN=replace-with-runner-bootstrap-token-32-bytes
AUTOFORGE_ADMIN_BOOTSTRAP_TOKEN=replace-with-admin-bootstrap-token-32-bytes
AUTOFORGE_TERMINAL_ACCESS_TOKEN=replace-with-terminal-access-token-32-bytes
AUTOFORGE_MASTER_KEY=replace-with-base64-encoded-32-byte-key

AUTOFORGE_MAX_JAR_BYTES=33554432
AUTOFORGE_RUNNER_CLAIM_RATE_LIMIT_PER_MINUTE=120
AUTOFORGE_SESSION_TTL_HOURS=12
AUTOFORGE_SCHEDULER_MAX_CPU_PERCENT=85
AUTOFORGE_SCHEDULER_MAX_MEMORY_PERCENT=85
AUTOFORGE_SCHEDULER_MAX_LOAD_PER_CPU=1
AUTOFORGE_SCHEDULER_METRICS_MAX_AGE_SECONDS=45
