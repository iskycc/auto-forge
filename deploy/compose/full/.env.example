AUTOFORGE_BACKEND_IMAGE=autoforge/backend:VERSION-amd64
AUTOFORGE_HTTP_BIND=0.0.0.0
AUTOFORGE_HTTP_PORT=3000

AUTOFORGE_DATA_VOLUME=autoforge-full-data
AUTOFORGE_POSTGRES_VOLUME=autoforge-postgres-data
AUTOFORGE_NATS_VOLUME=autoforge-nats-data
AUTOFORGE_REDIS_VOLUME=autoforge-redis-data
AUTOFORGE_MINIO_VOLUME=autoforge-minio-data
AUTOFORGE_EDGE_NETWORK=autoforge-edge
AUTOFORGE_CORE_NETWORK=autoforge-core
