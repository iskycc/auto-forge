AUTOFORGE_BACKEND_IMAGE=autoforge/backend:VERSION-amd64
AUTOFORGE_NODE_BIND=10.20.0.13
AUTOFORGE_HTTP_PORT=3000
AUTOFORGE_NODE_DATA_VOLUME=autoforge-platform-3-data

# 0 allows the host/container allocation; use explicit limits when sharing a host.
AUTOFORGE_WEB_CPUS=0
AUTOFORGE_WEB_MEMORY_LIMIT=0
AUTOFORGE_WORKER_CPUS=0
AUTOFORGE_WORKER_MEMORY_LIMIT=0
