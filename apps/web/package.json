    "exceljs": "^4.4.0",
    "ldapts": "8.1.5",
    "lucide-react": "1.30.0",
    "nats": "2.29.3",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.0",
    "server-only": "0.0.1",
    "ssh2": "1.17.0",
    "tailwind-merge": "3.7.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
