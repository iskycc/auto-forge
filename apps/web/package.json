    "@ant-design/nextjs-registry": "1.3.0",
    "@autoforge/application": "workspace:*",
    "@autoforge/cache": "workspace:*",
    "@autoforge/contracts": "workspace:*",
    "@autoforge/db": "workspace:*",
    "@autoforge/ddt-import": "workspace:*",
    "@autoforge/domain": "workspace:*",
    "@autoforge/ids": "workspace:*",
    "@autoforge/object-store": "workspace:*",
    "@autoforge/platform-config": "workspace:*",
    "@autoforge/queue": "workspace:*",
    "@autoforge/runner-sdk": "workspace:*",
    "@autoforge/testng-discovery": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.6.5",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
