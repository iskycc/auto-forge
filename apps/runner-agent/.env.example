AUTOFORGE_SERVER_URL=https://autoforge.internal
AUTOFORGE_AGENT_DATA_DIR=/var/lib/autoforge-agent
AUTOFORGE_AGENT_NAME=runner-01
AUTOFORGE_AGENT_LABELS=linux,java
AUTOFORGE_AGENT_MAX_CONCURRENCY=1
# One-time token supplied only during first registration; the server consumes it atomically.
# AUTOFORGE_AGENT_CA_FILE=/etc/autoforge-agent/ca.pem
# Interactive terminal is disabled by default and always runs as the Agent service account.
# AUTOFORGE_AGENT_TERMINAL_ENABLED=true
# AUTOFORGE_AGENT_TERMINAL_SHELL=/bin/sh
# AUTOFORGE_AGENT_TERMINAL_MAX_SESSIONS=1
# AUTOFORGE_AGENT_TERMINAL_MAX_DURATION=1h
