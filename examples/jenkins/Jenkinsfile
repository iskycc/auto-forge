pipeline {
  agent { label 'linux && jdk21' }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'AUTOFORGE_BASE_URL', defaultValue: 'https://autoforge.internal', description: 'AutoForge 控制面地址')
    string(name: 'AUTOFORGE_PROJECT_ID', defaultValue: '', description: '目标项目 ID')
    string(name: 'AUTOFORGE_PROJECT_VERSION', defaultValue: '1.0.0', description: '目标项目版本名称')
    string(name: 'AUTOFORGE_SUITE_ID', defaultValue: '', description: '已绑定同一项目版本的用例任务 ID')
  }

  environment {
    DEPENDENCY_ARCHIVE = 'target/autoforge-dependencies.zip'
  }

  stages {
    stage('构建与测试') {
      steps {
        sh 'mvn --batch-mode clean test dependency:copy-dependencies -DoutputDirectory=target/autoforge-dependencies'
        sh '(cd target/autoforge-dependencies && zip -q -r ../autoforge-dependencies.zip .)'
      }
    }

    stage('发布依赖压缩包') {
      steps {
        archiveArtifacts artifacts: "${DEPENDENCY_ARCHIVE}", fingerprint: true
        script {
          env.DEPENDENCY_SHA256 = sh(
            script: "sha256sum '${DEPENDENCY_ARCHIVE}' | awk '{print \\$1}'",
            returnStdout: true
          ).trim()
          env.DEPENDENCY_SIZE = sh(
            script: "stat -c %s '${DEPENDENCY_ARCHIVE}'",
            returnStdout: true
          ).trim()
        }
        withCredentials([string(credentialsId: 'autoforge-api-key', variable: 'AUTOFORGE_API_KEY')]) {
          autoforgePublishDependencies(
            baseUrl: params.AUTOFORGE_BASE_URL,
            apiKey: env.AUTOFORGE_API_KEY,
            projectId: params.AUTOFORGE_PROJECT_ID,
            version: params.AUTOFORGE_PROJECT_VERSION,
            dependencyUrl: "${env.BUILD_URL}artifact/${env.DEPENDENCY_ARCHIVE}",
            sha256: env.DEPENDENCY_SHA256,
            sizeBytes: env.DEPENDENCY_SIZE as Long
          )
        }
      }
    }

    stage('执行 AutoForge 任务') {
      steps {
        script {
          withCredentials([string(credentialsId: 'autoforge-api-key', variable: 'AUTOFORGE_API_KEY')]) {
            def result = autoforgeRun(
              baseUrl: params.AUTOFORGE_BASE_URL,
              apiKey: env.AUTOFORGE_API_KEY,
              suiteId: params.AUTOFORGE_SUITE_ID
            )
            currentBuild.description = "AutoForge：通过 ${result.totalPassed}/${result.totalCases}，最终失败 ${result.finalFailed}"
            // 插件已输出可点击的“完整结果”，无需重复打印原始链接。
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'target/surefire-reports/**', allowEmptyArchive: true
    }
  }
}
