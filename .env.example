AUTOFORGE_MODE=lite
AUTOFORGE_DATA_DIR=./data
AUTOFORGE_MAX_JAR_BYTES=33554432
# 至少 32 字符；每个值只能成功注册一台 Runner，未设置时注册接口关闭。
# AUTOFORGE_RUNNER_BOOTSTRAP_TOKEN=replace-with-an-offline-generated-secret
# 每台 Runner 每分钟最多发起的 assignment claim 请求数。
AUTOFORGE_RUNNER_CLAIM_RATE_LIMIT_PER_MINUTE=120
# 至少 32 字符；仅首次创建系统管理员使用，成功后从运行环境移除。
# AUTOFORGE_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-admin-bootstrap-secret
# 32 字节随机值的 Base64；启用 LDAP bind 密码或执行密文前必填。
# AUTOFORGE_MASTER_KEY=replace-with-base64-encoded-32-byte-key
AUTOFORGE_SESSION_TTL_HOURS=12
# 至少 32 字符；仅供 Web 与终端网关内部签发/校验短时票据，不是用户访问令牌；未设置时终端网关关闭。
# AUTOFORGE_TERMINAL_ACCESS_TOKEN=replace-with-a-different-offline-generated-secret
# 调度准入阈值；只有全部满足且指标未过期的执行机才会收到新分配。
AUTOFORGE_SCHEDULER_MAX_CPU_PERCENT=85
AUTOFORGE_SCHEDULER_MAX_MEMORY_PERCENT=85
AUTOFORGE_SCHEDULER_MAX_LOAD_PER_CPU=1
AUTOFORGE_SCHEDULER_METRICS_MAX_AGE_SECONDS=45

# Full 模式配置（AUTOFORGE_MODE=full 时全部必填）
# AUTOFORGE_DATABASE_URL=postgresql://autoforge:change-me@postgres:5432/autoforge
# AUTOFORGE_NATS_SERVERS=nats://nats:4222
# Full 独立工作器；Web 不消费内部调度消息。
# AUTOFORGE_WORKER_ID=full-worker-1
# AUTOFORGE_WORKER_CONCURRENCY=16
# AUTOFORGE_WORKER_HEALTH_PORT=3001
# AUTOFORGE_WORKER_METRICS_ENABLED=0
# AUTOFORGE_WORKER_SHUTDOWN_GRACE_MS=30000
# AUTOFORGE_POSTGRES_MIGRATIONS_DIR=/app/packages/db/drizzle/postgresql
# AUTOFORGE_REDIS_URL=redis://redis:6379
# AUTOFORGE_MINIO_ENDPOINT=http://minio:9000
# AUTOFORGE_MINIO_ACCESS_KEY=autoforge
# AUTOFORGE_MINIO_SECRET_KEY=change-me
# AUTOFORGE_MINIO_BUCKET=autoforge-objects
# AUTOFORGE_MINIO_REGION=us-east-1
